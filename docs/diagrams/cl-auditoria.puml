@startuml
!include _base.puml

title Modelo de domínio — notificação e trilha de auditoria

skinparam classAttributeIconSize 0
left to right direction

class "<<entidade>>\nNotificação" as Notificacao {
  - id : Int
  - usuarioId : Int
  - tipo : TipoEvento
  - titulo : String
  - mensagem : String
  - dados : String? "JSON em texto"
  - lida : Boolean = false
  - lidaEm : DateTime?
  - criadoEm : DateTime
}

enum "Tipo de evento" as TipoEvento {
  TAREFA_CONCLUIDA
  TAREFA_APROVADA
  TAREFA_REJEITADA
  TAREFA_PEDIU_REVISAO
  ISSUE_ABERTA
  ISSUE_ATRIBUIDA
  RELATORIO_ENVIADO
  AVISO_GERAL
}

class "Público" as Publico {
  <<todos_ativos>> | <<lista_de_ids>>
}

class "<<entidade>>\nTrilha de auditoria" as Historico {
  - id : Int
  - entidade : String
  - entidadeId : Int
  - acao : String
  - executadoPor : Int
  - executadoEm : DateTime
  - descricao : String?
  - metadados : Json?
  - valoresAnteriores : Json?
  - valoresNovos : Json?
}

class "Usuário" as Usuario

Publico ..> Notificacao : destinatários
TipoEvento ..> Notificacao : classifica
Usuario "1" --> "0..*" Notificacao : recebe
Usuario "1" --> "0..*" Historico : executa

note right of Notificacao
  A notificação é escrita
  diretamente para cada
  destinatário: não há caixa
  de entrada compartilhada nem
  leitura por grupo.

  Os dados estruturados são
  gravados como texto e
  devolvidos sem interpretação
  pelo servidor.
end note

note bottom of Historico
  A mesma estrutura atende a
  doisusos com formatos
  diferentes: o registro de
  auditorsia, que guarda o antes
  e o depois, e a lista de avisos
  do laboratório, que lê o
  metadado de usuário e a
  descrição da linha.
end note

@enduml