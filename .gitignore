# Internal engineering files — methodology, specs, tests, design system docs
# These are local-only development artifacts; never push to origin.
.spec/
.future/
future/
# tests/: excecao registrada (2026-09-30, decisao do agente com dono OK) — a malha de
# regressao do clean-arch (golden/contract/roundtrip, 1245 testes) passa a ser versionada.
# Somente os conteudos de teste; screenshots de e2e continuam ignorados.
tests/*
!tests/e2e
!tests/e2e/**
!tests/fixtures
!tests/fixtures/**
!tests/integration
!tests/integration/**
!tests/mocks
!tests/mocks/**
!tests/unit
!tests/unit/**
!tests/setup.ts
tests/e2e/__screenshots__/
.worktrees/
scripts/capture-visual-baseline.mjs
scripts/compare-visual-baseline.mjs

# Documentacao local nao versionada (decisao do dono 2026-10-01): declarada aqui em vez
# de ficar como untracked solto, para nao reaparecer como surpresa nem se perder num clean.
docs/Projeto/

# Intermediarios da geracao do documento (docs/displayquest.html): os SVGs sao
# re-renderizados pelo build a partir de docs/diagrams, nao versionados.
docs/.build/

# Credenciais usadas pelo script de captura de telas do guia do usuario.
# Nunca commitar: contem senha de uma conta real da instancia de operacao.
docs/.capture.env
displayquest-v2/clean-arch/PENDENCIAS-FINAIS.md
displayquest-v2/plan-v2/UI-UX.md
