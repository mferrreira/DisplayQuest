    {
      "name": "weekly_report_generate",
      "title": "Gerar relatório semanal",
      "description": "Gera o relatório de uma pessoa para o período. Gate: self ou MANAGE_USERS — o laboratorista não gera para terceiro por esta rota.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "weekStart": {
            "type": "string",
            "minLength": 1
          },
          "weekEnd": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "userId",
          "weekStart",
          "weekEnd"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "returns": "weeklyReport: relatório gerado.",
      "errors": [
        400,
        401,
        403,
        404
      ]
    },
    {
      "name": "weekly_report_bulk_generate",
      "title": "Gerar relatórios em lote",
      "description": "Gera relatórios para TODOS os usuários ativos nos períodos que cobrem de `from` a `to`. Exige MANAGE_USERS. É a escrita de maior alcance do sistema: use período curto e só no projeto de areia.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "periodType": {
            "type": "string",
            "enum": [
              "weekly",
              "biweekly",
              "monthly",
              "semiannual",
              "annual"
            ]
          },
          "from": {
            "type": "string",
