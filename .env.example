# Required for local dev (copy to .env — gitignored)
DATABASE_URL="postgresql://display-quest:display-quest123@localhost:5432/display-quest"
# next-auth v4 (D-13): WITHOUT a secret, dev-issued session cookies fail server-side
# verification and every API call returns 401. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="<openssl rand -base64 32>"
# Must match the port the dev server runs on (3001 locally: docker build occupies 3000)
NEXTAUTH_URL="http://localhost:3001"
