# Required for local dev (copy to .env — gitignored)
# Postgres creds — usadas pelo docker-compose (${VAR:?}); gere uma senha real em prod
POSTGRES_USER=display-quest
POSTGRES_PASSWORD=CHANGE_ME
# Nome do banco — o compose inicializa o `postgres` com ele e monta a DATABASE_URL do app
# (postgresql://…/display-quest). Default do compose: display-quest.
POSTGRES_DB=display-quest
DATABASE_URL="postgresql://display-quest:CHANGE_ME@localhost:5432/display-quest"
# next-auth v4 (D-13): OBRIGATÓRIO — gere um secret real com: openssl rand -base64 32
# Sem secret, sessões dev-issued falham na verificação server-side e toda API vira 401.
NEXTAUTH_SECRET=""
# Must match the port the dev server runs on (3001 locally: docker build occupies 3000)
NEXTAUTH_URL="http://localhost:3001"
# Bucket S3-compatible dos blobs (V5-1/DEC-101: serviço `seaweedfs` do compose).
# OBRIGATÓRIO: o compose recusa subir sem S3_ACCESS_KEY/S3_SECRET_KEY (`${VAR:?}`) e
# `npm run check:env` valida o secret. Gere cada um com: openssl rand -base64 24
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY=""
S3_BUCKET="displayquest"
# Do host (scripts/testes) fale com o loopback publicado pelo override; de dentro do
# compose o `app` usa http://seaweedfs:8333 (V5-2 em diante).
S3_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
# SeaweedFS não faz virtual-host style: mantenha true (default do código).
S3_FORCE_PATH_STYLE="true"

# IA do rascunho do relatório técnico (V5-9c, DEC-169). Endpoint OpenAI-compatible:
# deploy em localhost:8080/v1, dev pela tailscale (100.112.10.76:8080/v1, DEC-152).
# Sem a env, o código cai no default http://localhost:8080/v1.
# O compose repassa as três (`${VAR:-}`): string VAZA conta como ausente no código.
# `next dev` lê o `.env` na partida — mudou a env, reinicie o dev server.
AI_BASE_URL=http://localhost:8080/v1
# Opcional: a header Authorization só sai quando existe (o servidor local não exige auth).
# AI_API_KEY=
# Nome do modelo no servidor (default "local").
# AI_MODEL=local

# Log de SQL do Prisma. Em producao o log de query fica desligado (warn/error sempre);
# ligue com "true" so para depurar — cada SQL vira uma linha em `docker logs`.
# PRISMA_LOG_QUERIES=true

# Servidor MCP de validação (plan-v7, fase 1; DEC-190/196/198).
# Conta de serviço do DisplayQuest usada pelo MCP — a senha NUNCA vai para o git,
# só para o ambiente. Gere com: openssl rand -base64 24. O compose recusa subir o
# serviço `mcp` sem DQ_AGENT_PASSWORD (`${VAR:?}`).
DQ_AGENT_EMAIL="mcp-agent@displayquest.local"
DQ_AGENT_PASSWORD=""
# Do host (dev/smoke) o MCP fala com o app no loopback; de dentro do compose o
# serviço `mcp` usa http://app:3000 (definido no próprio compose).
DQ_API_BASE="http://127.0.0.1:3000"
# Porta e bind do servidor MCP. Local: 127.0.0.1; no compose o bind é 0.0.0.0
# porque a fase 1 atende a LAN (a barreira é a rede, não o bind).
MCP_PORT="8787"
MCP_BIND_IP="127.0.0.1"
# Timeout das chamadas ao app (JSON; binário é o dobro).
MCP_REQUEST_TIMEOUT_MS="15000"
# Origens extras aceitas no POST /mcp (lista por vírgula; hostname ou origem
# completa). Sem ela, loopback + o IP do bind já passam.
# DQ_ALLOWED_ORIGINS="qd.local,http://qd.local:8787"
