generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                   Int                    @id @default(autoincrement())
  name                 String
  email                String                 @unique
  // plan-v8 (DEC-211/216): `points` perde o triple-role. Continua uma coluna Int com default 0,
  // mas passa a ser o PLACAR DO MÊS (ranking) — moeda da loja sai para `coins` e a métrica
  // cumulativa de ranking sai para os snapshots (`month_history`/`season_history`). Na virada
  // 1:1 do deploy o saldo atual vira `coins` e o placar começa em 0 (DEC-216).
  points               Int                    @default(0)
  // V8-1 (DEC-215/216): moeda da loja, VITALÍCIA — única fonte é atividade de cronograma
  // aprovada (a mudança de destino do crédito é a V8-5). Entre V8-1 e V8-4 a coluna existe sem
  // fonte, por ordem das ondas (PLAN §4).
  coins                Int                    @default(0)
  // V8-1 (DEC-214): XP da TEMPORADA anual, com piso 0 na aritmética do domínio (a regra é a
  // V8-3). Não confudir com a derivação dormente `xp = max(0, points)` em `Progression.ts`,
  // que é sobre `points` e não sobrevive como está (V8-6).
  xp                   Int                    @default(0)
  // V8-6 (DEC-217): o elo da TEMPORADA, derivado do XP pela escada do dominio
  // (`backend/domain/gamification/elo-rules.ts` — BRONZE 0 / PRATA 400 / OURO 900 / PLATINA 1500 /
  // DIAMANTE 2400 / DESAFIANTE 3600, slots 0/1/2/2/3/3). String com default, como `status` e
  // `track`: o vocabulario e fechado no dominio e a guarda e o teste (`gamification-elo.test.ts`),
  // porque o banco aceitaria qualquer texto e o `tsc` so protege quem importa a constante. Toda
  // escrita de XP recomputa o elo na mesma transacao (evento, revisao semanal), e o fechamento da
  // temporada devolve o elo ao primeiro degrau junto com o XP.
  elo                  String                 @default("BRONZE")
  completedTasks       Int                    @default(0)
  password             String?
  status               String                 @default("pending")
  weekHours            Float                  @default(0)
  createdAt            DateTime               @default(now())
  currentWeekHours     Float                  @default(0)
  roles                UserRole[]
  avatar               String?
  bannerKey            String?
  bio                  String?
  profileVisibility    ProfileVisibility      @default(public)
  // V5-4a (DEC-138): os dados de pessoa que os dois formulários oficiais pedem. Vivem na
  // PESSOA, não no vínculo — decisão do dono em 2026-10-13. Escrita: o próprio OU quem gerencia
  // contas (o gate do perfil). Leitura: `cpf` é o único restrito (próprio OU MANAGE_USERS); os
  // demais seguem a leitura aberta do perfil. Vocabulários fechados em
  // backend/domain/identity/person-data-rules.ts, derivados dos campos medidos no AcroForm
  // (nivel_*, is_pibic/is_pibiti/is_btp..., is_cnpq/is_fapemig/is_outra + agencia_outra).
  cpf                String?
  registrationNumber String?
  course             String?
  scholarshipType    String?
  fundingAgency      String?
  fundingAgencyOther String?
  level              String?
  createdBadges        badges[]               @relation("UserCreatedBadges")
  daily_logs           daily_logs[]           @relation("UserDailyLogs")
  history              history[]              @relation("UserHistory")
  assignedIssues       issues[]               @relation("UserAssignedIssues")
  reportedIssues       issues[]               @relation("UserReportedIssues")
  lab_events           lab_events[]           @relation("UserLabEvents")
  lab_responsibilities lab_responsibilities[] @relation("UserLabResponsibilities")
  projectMemberships   project_members[]      @relation("UserProjectMemberships")
  projects             projects[]             @relation("UserProjects")
  ledProjects          projects[]             @relation("UserProjectLeadership")
  purchases            purchases[]            @relation("UserPurchases")
  tasks                tasks[]                @relation("UserTasks")
  createdTasks         tasks[]                @relation("UserCreatedTasks")
  taskAssignments      task_assignees[]       @relation("UserTaskAssignments")
  taskProgress         task_user_progress[]   @relation("UserTaskProgress")
  awardedBadges        user_badges[]          @relation("UserAwardedBadges")
  badges               user_badges[]          @relation("UserBadges")
  schedules            user_schedules[]       @relation("UserSchedules")
  weekly_hours_history weekly_hours_history[] @relation("UserWeeklyHoursHistory")
  weekly_reports       weekly_reports[]       @relation("UserWeeklyReports")
  work_sessions        work_sessions[]        @relation("UserWorkSessions")
  notifications        notifications[]        @relation("UserNotifications")
  projectReports       project_reports[]      @relation("ProjectReportAuthor")
  // V5-2c: quem subiu um anexo do projeto. RESTRICT (sem onDelete) — ver o comentário no
  // model `project_attachments`; a guarda user-delete-schema-drift.test.ts confere os dois lados.
  projectAttachments   project_attachments[]  @relation("ProjectAttachmentUploader")
  uploadedActivityFiles project_activity_files[] @relation("ActivityFileUploader")
  // V5-5: as três relações do cronograma com pessoa são `SetNull` (ver o comentário no model
  // `project_activities`): excluir uma pessoa não apaga cronograma nem bloqueia a exclusão.
  activityResponsibilities   project_activities[] @relation("ActivityResponsible")
  activityCompletionRequests project_activities[] @relation("ActivityCompletionRequester")
  activityCompletionApprovals project_activities[] @relation("ActivityCompletionApprover")
  // V5-10 (DEC-170): atestado é documento GERADO sobre o vínculo — `userId` Cascade (não
  // bloqueia excluir conta; o PDF é regenerável a partir dos dados) e `generatedBy` SetNull
  // (auditoria). Nenhum dos dois entra na guarda de FKs bloqueantes.
  certificatesAsMember  certificates[] @relation("CertificateMember")
  certificatesGenerated certificates[] @relation("CertificateGenerator")
  // V8-1 (DEC-212/213): as duas trilhas de histórico da gamificação nova. Cascade, pelo
  // precedente de `weekly_hours_history` (a guarda user-delete-schema-drift.test.ts confere:
  // Cascade não entra em `countBlockingDependencies`).
  monthHistory  month_history[]  @relation("UserMonthHistory")
  seasonHistory season_history[] @relation("UserSeasonHistory")
}

model projects {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  createdAt   String
  createdBy   Int
  leaderId    Int?
  status      String
  links       Json?
  // V5-2b (DEC-61/63). Datas civis `YYYY-MM-DD` — mesma decisão de `createdAt`/`dueDate`,
  // que já são String: a aritmética do plano é de dias civis (backend/domain/time/civil-day).
  // V8-1 (DEC-215): `points` SAI daqui. O saldo Hamilton do projeto não é mais trilha do
  // sistema — o prêmio de atividade aprovada vira moeda da pessoa (`users.coins`, V8-5) e o
  // publicador `TaskCompletedEvent -> projects.points` (DEC-63) saiu junto.
  startDate     String?
  endDate       String?
  editalNumber  String?
  processNumber String?
  // V5-4a (DEC-140): o nº PROPPI aparece nos dois formulários oficiais e é dado do projeto,
  // não da pessoa nem do vínculo.
  proppiNumber  String?
  // V5-2d (DEC-102): chave do objeto no bucket, nunca um caminho de disco (regra 12 do plano).
  // Uma coluna por slot: "uma logo por projeto" é estrutural, não regra a validar.
  logoKey       String?
  bannerKey     String?
  daily_logs  daily_logs[]      @relation("ProjectDailyLogs")
  members     project_members[] @relation("ProjectMemberships")
  creator     users             @relation("UserProjects", fields: [createdBy], references: [id])
  leader      users?            @relation("UserProjectLeadership", fields: [leaderId], references: [id])
  tasks       tasks[]           @relation("ProjectTasks")
  work_sessions work_sessions[] @relation("WorkSessionProject")
  project_reports project_reports[] @relation("ProjectReports")
  technical_reports technical_reports[] @relation("ProjectTechnicalReports")
  certificates      certificates[]      @relation("ProjectCertificates")
  deliverables project_deliverables[] @relation("ProjectDeliverables")
  attachments  project_attachments[]   @relation("ProjectAttachments")
  goals        project_goals[]         @relation("ProjectGoals")
  activities   project_activities[]    @relation("ProjectActivities")
}

// V5-2c (DEC-61/63): entregável é (nome, quantidade) — a lista do que o projeto entrega.
// Sem FK para users: entregável não tem responsável próprio (mesma escolha de task_subtasks).
model project_deliverables {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  project   projects @relation("ProjectDeliverables", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// V5-2c (DEC-101): o binário mora no bucket (`blobKey` é a chave), nunca em disco do backend.
// `uploadedBy` é RESTRICT de propósito, como `project_reports.authorId`: o anexo é dado do
// projeto, não de quem subiu — excluir o usuário não pode apagar o que o projeto entregou.
model project_attachments {
  id          Int      @id @default(autoincrement())
  projectId   Int
  blobKey     String   @unique
  name        String
  contentType String
  size        Int
  uploadedBy  Int
  uploadedAt  DateTime @default(now())
  project     projects @relation("ProjectAttachments", fields: [projectId], references: [id], onDelete: Cascade)
  uploader    users    @relation("ProjectAttachmentUploader", fields: [uploadedBy], references: [id])

  @@index([projectId])
}

// V5-5 (DEC-61/103/126/151/156): as metas do projeto — os OBJETIVOS ESPECÍFICOS da brochura
// (seção 5) e os ENTREGÁVEIS quantitativos (seção 10) existem nela, e os dois têm forma
// diferente: texto puro, ou número + texto. `target` é nulo quando a meta é só texto.
model project_goals {
  id          Int      @id @default(autoincrement())
  projectId   Int
  order       Int
  target      Int?
  description String
  createdAt   DateTime @default(now())
  project     projects @relation("ProjectGoals", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// V5-5: a linha do cronograma. Na brochura é "Etapa N | Descrição da Atividade | Total em
// Meses"; no sistema (DEC-126) é uma linha da grade meses × atividades, e o total é a contagem
// das marcas. `firstMonth`/`lastMonth` chegam porque a linha é contígua por decisão — o conjunto
// de meses é derivado deles, nunca guardado. O período (primeiro dia do primeiro mês ao último
// dia do último) é derivado na regra, não armazenado.
model project_activities {
  id                Int       @id @default(autoincrement())
  projectId         Int
  order             Int
  description       String
  // `SetNull`, não o default `Restrict`: a atividade é dado do projeto, e excluir uma pessoa não
  // pode apagar o cronograma nem transformar um responsável em motivo de 409 na exclusão de
  // usuário (DEC-55). A linha sobrevive sem responsável.
  responsibleId     Int?
  firstMonth        String
  lastMonth         String
  // DEC-76: duas fases. O formulário não escreve status — só o fluxo de solicitar/aprovar (V5-7).
  status            String    @default("OPEN")
  requestedBy       Int?
  requestedAt       DateTime?
  approvedBy        Int?
  approvedAt        DateTime?
  // DEC-64: uma notificação de atraso por atividade, não uma por dia.
  overdueNotifiedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  project     projects @relation("ProjectActivities", fields: [projectId], references: [id], onDelete: Cascade)
  responsible users?   @relation("ActivityResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  requestedByUser users? @relation("ActivityCompletionRequester", fields: [requestedBy], references: [id], onDelete: SetNull)
  approvedByUser  users? @relation("ActivityCompletionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  // V5-6 (DEC-99): as tasks da etapa. A leitura do cronograma não inclui tasks (o painel não
  // lista tarefa por linha); quem conta é o fluxo de solicitar conclusão (V5-7).
  tasks       tasks[]  @relation("ActivityTasks")
  // V5-7a (DEC-157/162): as provas anexadas para solicitar a conclusão da etapa.
  files       project_activity_files[] @relation("ActivityEvidence")

  @@index([projectId])
}

// V5-7a (DEC-76/133/157/162): a prova da atividade. Desenho do anexo de projeto (DEC-133): a
// rota move byte pelo seam, o módulo guarda metadado + autorização. `uploadedBy` é FK
// bloqueante (default Restrict): prova é dado do projeto, não de quem subiu — mesma razão
// medida da 17ª FK (DEC-134). Apagar a linha do cronograma apaga as provas (Cascade): a prova
// existe para aquela etapa; sem etapa, não há o que provar.
model project_activity_files {
  id          Int      @id @default(autoincrement())
  activityId  Int
  blobKey     String   @unique
  name        String
  contentType String
  size        Int
  uploadedBy  Int
  uploadedAt  DateTime @default(now())
  activity    project_activities @relation("ActivityEvidence", fields: [activityId], references: [id], onDelete: Cascade)
  uploader    users              @relation("ActivityFileUploader", fields: [uploadedBy], references: [id])

  @@index([activityId])
}

model project_members {
  id           Int      @id @default(autoincrement())
  projectId    Int
  userId       Int
  joinedAt     DateTime @default(now())
  roles        UserRole[]
  // V5-4b (DEC-69/140/149): dados do vínculo. `cargaHoraria` é a carga contratada, que alimenta
  // o atestado (carga_8 / carga_20 / carga_adaptada) — não é `users.weekHours`, a meta semanal da
  // pessoa (DEC-140). `categoria` sai dos dois checkboxes medidos do AcroForm (`is_bolsista`,
  // `is_voluntario`) e é nula quando não declarada. `situacao` nunca é nula. `dataEntrada` é data
  // civil `YYYY-MM-DD` (DEC-132), e `joinedAt` continua o instantâneo em que a linha nasceu.
  lattes       String?
  cargaHoraria Float?
  categoria    String?
  situacao     String   @default("ATIVO")
  dataEntrada  String?
  project      projects @relation("ProjectMemberships", fields: [projectId], references: [id], onDelete: Cascade)
  user         users    @relation("UserProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model tasks {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?
  status         String
  priority       String
  assignedTo     Int?
  projectId      Int?
  dueDate        String?
  points         Int       @default(0)
  completed      Boolean   @default(false)
  completedAt    DateTime?
  taskVisibility String    @default("delegated")
  isGlobal       Boolean   @default(false)
  groupTaskId    Int?                    // Vincula cópias individuais criadas a partir do mesmo template
  createdBy      Int?
  // V5-6 (DEC-99): a linha do cronograma a que a tarefa pertence. `SetNull`, não o default
  // `Restrict`: apagar uma etapa do cronograma não apaga tarefa nenhuma (DEC-156), e a tarefa
  // sobrevive sem vínculo. A checagem de projeto é do use case, não da FK.
  activityId     Int?
  creator        users?    @relation("UserCreatedTasks", fields: [createdBy], references: [id])
  assignee       users?    @relation("UserTasks", fields: [assignedTo], references: [id])
  projectObj     projects? @relation("ProjectTasks", fields: [projectId], references: [id])
  activityObj    project_activities? @relation("ActivityTasks", fields: [activityId], references: [id], onDelete: SetNull)
  assignees      task_assignees[] @relation("TaskAssignees")
  workSessions   work_session_tasks[] @relation("TaskWorkSessions")
  taskProgress   task_user_progress[] @relation("TaskUserProgress")
  subtasks       task_subtasks[]      @relation("TaskSubtasks")

  @@index([activityId])
}

model task_assignees {
  id         Int      @id @default(autoincrement())
  taskId      Int
  userId      Int
  assignedBy  Int?
  assignedAt  DateTime @default(now())
  task        tasks    @relation("TaskAssignees", fields: [taskId], references: [id], onDelete: Cascade)
  user        users    @relation("UserTaskAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model task_user_progress {
  id           Int      @id @default(autoincrement())
  taskId        Int
  userId        Int
  status        String   @default("to-do")
  pickedAt      DateTime?
  completedAt   DateTime?
  awardedPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  task          tasks    @relation("TaskUserProgress", fields: [taskId], references: [id], onDelete: Cascade)
  user          users    @relation("UserTaskProgress", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@index([taskId, status])
}

/// plan-v4 · V4-4 — subtask da tarefa mãe (DEC-78). Sem responsável próprio e sem prazo próprio
/// (herda os dois da mãe — D-D), por isso não há FK para users aqui. Cascade igual às outras
/// tabelas-filhas de tasks (`task_assignees`, `task_user_progress`): apagar a mãe apaga as subtasks.
model task_subtasks {
  id          Int       @id @default(autoincrement())
  taskId      Int
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  task        tasks     @relation("TaskSubtasks", fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, completed])
}

model rewards {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Int
  available   Boolean     @default(true)
  purchases   purchases[] @relation("RewardPurchases")
}

model purchases {
  id           Int     @id @default(autoincrement())
  userId       Int
  rewardId     Int
  rewardName   String
  price        Int
  purchaseDate String
  status       String
  reward       rewards @relation("RewardPurchases", fields: [rewardId], references: [id])
  user         users   @relation("UserPurchases", fields: [userId], references: [id])
}

model lab_responsibilities {
  id            Int     @id @default(autoincrement())
  userId        Int
  userName      String
  startTime     String
  endTime       String?
  pausedAt      String? // ISO quando pausada; null enquanto em execução
  totalPausedMs Int     @default(0)
  notes         String?
  user          users   @relation("UserLabResponsibilities", fields: [userId], references: [id])
}

model daily_logs {
  id            Int            @id @default(autoincrement())
  userId        Int
  projectId     Int?
  date          DateTime
  note          String?
  createdAt     DateTime       @default(now())
  workSessionId Int?           @unique
  project       projects?      @relation("ProjectDailyLogs", fields: [projectId], references: [id])
  user          users          @relation("UserDailyLogs", fields: [userId], references: [id])
  workSession   work_sessions? @relation("WorkSessionDailyLog", fields: [workSessionId], references: [id], onDelete: Cascade)
}

model weekly_reports {
  id        Int      @id @default(autoincrement())
  userId    Int
  userName  String
  weekStart DateTime
  weekEnd   DateTime
  totalLogs Int      @default(0)
  summary   String?
  createdAt DateTime @default(now())
  user      users    @relation("UserWeeklyReports", fields: [userId], references: [id])
}

model project_reports {
  id          Int      @id @default(autoincrement())
  projectId   Int
  authorId    Int
  periodType  String
  periodStart DateTime
  periodEnd   DateTime
  title       String?
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     projects @relation("ProjectReports", fields: [projectId], references: [id], onDelete: Cascade)
  author      users    @relation("ProjectReportAuthor", fields: [authorId], references: [id])
  attachments report_attachments[] @relation("ReportAttachments")

  @@unique([projectId, periodType, periodStart, authorId])
  @@index([projectId, periodType])
}

// V5-9 (DEC-70/139/167): relatório técnico por projeto × tipo — um registro editável por
// par, sem FK para atividade e sem dono pessoa (DEC-139: o texto é um só; o DOCX é gerado
// N vezes, um por membro). `content` é o texto editável (rascunho de IA ou humano); os
// arquivos gerados vivem no bucket com chave derivada, não em coluna.
model technical_reports {
  id        Int      @id @default(autoincrement())
  projectId Int
  type      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   projects @relation("ProjectTechnicalReports", fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@map("technical_reports")
}

// V5-10 (DEC-75/170/171): atestado de frequência — um por projeto × membro × mês de
// referência. Sem status próprio (DEC-75: o status do projeto cobre). A linha é o registro;
// o PDF mora no bucket com chave DERIVADA (`projects/<id>/certificates/<userId>/<month>.pdf`)
// — regenerar sobrescreve o objeto, como a capa do projeto (DEC-135) e o DOCX (DEC-167).
// `userId` Cascade e `generatedBy` SetNull: atestado é documento gerado, não dado-fonte;
// nenhum dos dois bloqueia excluir conta (ver o comentário no model `users`).
model certificates {
  id          Int      @id @default(autoincrement())
  projectId   Int
  userId      Int
  month       String
  blobKey     String
  fileName    String
  generatedBy Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   projects @relation("ProjectCertificates", fields: [projectId], references: [id], onDelete: Cascade)
  member    users    @relation("CertificateMember", fields: [userId], references: [id], onDelete: Cascade)
  generator users?   @relation("CertificateGenerator", fields: [generatedBy], references: [id], onDelete: SetNull)

  @@unique([projectId, userId, month])
  @@map("certificates")
}

model report_attachments {
  id         Int             @id @default(autoincrement())
  reportId   Int
  fileName   String
  storedPath String
  mimeType   String
  sizeBytes  Int
  uploadedBy Int
  createdAt  DateTime        @default(now())
  report     project_reports @relation("ReportAttachments", fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model user_schedules {
  id        Int      @id @default(autoincrement())
  userId    Int
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  user      users    @relation("UserSchedules", fields: [userId], references: [id])
}

model laboratory_schedules {
  id        Int      @id @default(autoincrement())
  dayOfWeek Int
  startTime String
  endTime   String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model history {
  id          Int      @id @default(autoincrement())
  entityType  String
  entityId    Int
  action      String
  performedBy Int
  performedAt DateTime @default(now())
  oldValues   Json?
  newValues   Json?
  description String?
  metadata    Json?
  // V8-1 (DEC-211): de qual trilha fala esta linha. Vocabulário fechado no domínio
  // (`backend/domain/gamification/tracks.ts` — POINTS | COINS | XP), com default POINTS. É String
  // como `entityType`/`action` (mesma escolha da DEC-141 para vocabulário: migration de linha sem
  // constraint no banco). Toda linha existente nasce POINTS — inclusive os awards antigos.
  // A chave do montante no JSON nomeia a trilha da linha (`pointsAwarded`, `coinsAwarded` na V8-5,
  // `xpAwarded` na V8-3); uma linha de ledger fala de uma trilha só.
  track       String   @default("POINTS")
  performer   users    @relation("UserHistory", fields: [performedBy], references: [id])

  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([performedAt])
  @@index([action])
}

model work_sessions {
  id        Int         @id @default(autoincrement())
  userId    Int
  userName  String
  startTime DateTime    @default(now())
  endTime   DateTime?
  duration  Float?
  activity  String?
  location  String?
  projectId Int?
  status    String      @default("active")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  dailyLog  daily_logs? @relation("WorkSessionDailyLog")
  user      users       @relation("UserWorkSessions", fields: [userId], references: [id], onDelete: Cascade)
  project   projects?   @relation("WorkSessionProject", fields: [projectId], references: [id])
  tasks     work_session_tasks[] @relation("WorkSessionTasks")
}

model work_session_tasks {
  id            Int           @id @default(autoincrement())
  workSessionId Int
  taskId        Int
  createdAt     DateTime      @default(now())
  workSession   work_sessions @relation("WorkSessionTasks", fields: [workSessionId], references: [id], onDelete: Cascade)
  task          tasks         @relation("TaskWorkSessions", fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([workSessionId, taskId])
  @@index([taskId])
}

model kanban_boards {
  id        Int      @id @default(autoincrement())
  name      String
  labId     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model lab_events {
  id        Int      @id @default(autoincrement())
  userId    Int
  userName  String
  date      DateTime
  note      String
  createdAt DateTime @default(now())
  user      users    @relation("UserLabEvents", fields: [userId], references: [id])
}

model weekly_hours_history {
  id         Int      @id @default(autoincrement())
  userId     Int
  userName   String
  weekStart  DateTime
  weekEnd    DateTime
  totalHours Float
  createdAt  DateTime @default(now())
  user       users    @relation("UserWeeklyHoursHistory", fields: [userId], references: [id], onDelete: Cascade)
}

// V8-1 (DEC-212): snapshot MENSAL do placar — a memória do ranking que deixou de ser cumulativo.
// `month` é data civil no formato `YYYY-MM` (a mesma régua de `backend/domain/time/civil-day.ts`,
// nunca um `Date` instantâneo). `points` guarda o saldo do mês NEGATIVO quando ele foi negativo
// (o mês perdoa, o histórico não apaga). A quem escreve é o `ResetMonthlyPointsUseCase` da V8-2
// com `systemActor("MONTHLY_POINTS_RESET")`.
// Idempotência por `(userId, month)`: a unique abaixo É a trava — o QUIRK-7C do weekly reset
// (rotina sem deduplicação) não é herdado (DEC-212).
// Cascade: histórico da pessoa não bloqueia excluir a conta (precedente `weekly_hours_history`).
model month_history {
  id             Int      @id @default(autoincrement())
  userId         Int
  month          String
  points         Int
  completedTasks Int      @default(0)
  createdAt      DateTime @default(now())
  user           users    @relation("UserMonthHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([month])
}

// V8-1 (DEC-213): livro-caixa da TEMPORADA (ano civil) por pessoa. Quem escreve é o
// `CloseSeasonUseCase` da V8-4 (`systemActor("SEASON_CLOSE")`, idempotência por `(userId, year)`
// — a unique abaixo é a trava). `points` é o somatório dos pontos mensais do ano, que é também o
// critério do troféu de CAMPEÃO. `elo`/`position` são preenchidos na V8-4/V8-6: o vocabulário do
// elo fecha em V8-6 (DEC-217), então a coluna é String por enquanto. Moedas e troféus conquistados
// não aparecem aqui porque não resetam — não há o que livro-caixar deles.
model season_history {
  id             Int      @id @default(autoincrement())
  userId         Int
  year           Int
  points         Int      @default(0)
  completedTasks Int      @default(0)
  xp             Int      @default(0)
  elo            String?
  position       Int?
  createdAt      DateTime @default(now())
  user           users    @relation("UserSeasonHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([year])
}

model badges {
  id          Int           @id @default(autoincrement())
  name        String
  description String
  icon        String?
  color       String?
  category    BadgeCategory
  criteria    Json?
  // V8-1 (DEC-218): lista fechada de `{verb, tier}` — o admin ESCOLHE do menu, nenhum número
  // livre. A validação do vocabulário (verbos `pontos_tarefa +%`, `pontos_sessao +%`,
  // `moedas_atividade +%`, `penalidade −%` × Tier1/Tier2/Tier3) é do domínio e entra na V8-6;
  // a coluna existe agora para a migration do catálogo não ter que esperar o motor.
  // Cada critério (Json) ganha `window`: `mes | temporada | vida` (DEC-219); o catálogo
  // existente migra com `vida` na data migration da V8-1.
  effects     Json?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  createdBy   Int
  creator     users         @relation("UserCreatedBadges", fields: [createdBy], references: [id])
  userBadges  user_badges[] @relation("BadgeUserBadges")
}

model user_badges {
  id       Int      @id @default(autoincrement())
  userId   Int
  badgeId  Int
  // V8-1 (DEC-218): conquistado é uma coisa, equipado é outra. A conquista continua vitalícia
  // (a unique abaixo é a trava — nunca se re-conquista); a pessoa escolhe quais ficam ativos no
  // perfil, e o teto de equipados é o slot do elo DO MOMENTO (BRONZE 0 / PRATA 1 / OURO 2 /
  // PLATINA 2 / DIAMANTE 3 / DESAFIANTE 3). O teto é regra de código (V8-6), não constraint
  // aqui: o elo muda com a temporada e a coluna não pode travar isso no banco.
  equipped Boolean  @default(false)
  earnedAt DateTime @default(now())
  earnedBy Int?
  badge    badges   @relation("BadgeUserBadges", fields: [badgeId], references: [id], onDelete: Cascade)
  awarder  users?   @relation("UserAwardedBadges", fields: [earnedBy], references: [id])
  user     users    @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model issues {
  id          Int           @id @default(autoincrement())
  title       String
  description String
  status      IssueStatus   @default(open)
  priority    IssuePriority @default(medium)
  category    String?
  reporterId  Int
  assigneeId  Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  resolvedAt  DateTime?
  assignee    users?        @relation("UserAssignedIssues", fields: [assigneeId], references: [id])
  reporter    users         @relation("UserReportedIssues", fields: [reporterId], references: [id])
}

enum UserRole {
  COORDENADOR
  GERENTE
  LABORATORISTA
  PESQUISADOR
  GERENTE_PROJETO
  COLABORADOR
  VOLUNTARIO
}

enum ProfileVisibility {
  public
  members_only
  private
}

enum BadgeCategory {
  achievement
  milestone
  special
  social
}

enum IssueStatus {
  open
  in_progress
  resolved
  closed
}

enum IssuePriority {
  low
  medium
  high
  urgent
}

model notifications {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  message   String
  data      String?   // JSON data
  read      Boolean   @default(false)
  // V5-8 (DEC-64): atraso de atividade é notificação URGENTE — o painel destaca por esta
  // coluna, não pelo `type`. Toda notificação existente nasce `false` (default).
  priority  Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?
  
  user      users     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notifications")
}
